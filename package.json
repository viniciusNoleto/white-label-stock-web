{
  "name": "white-label-inventory-system",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "start": "node dist/white-label-inventory-system/server/server.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx db/seed.ts",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:api": "vitest run --config vitest.api.config.mts",
    "test:api:coverage": "vitest run --config vitest.api.config.mts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.4",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/flag-icons": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "^1.8.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "i18next": "^26.5.7",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "@spartan-ng/cli": "^1.8.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
