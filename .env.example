APP_ENV=local
APP_PORT=3005
# Homolog only — host port for HTTPS (nginx)
APP_SSL_PORT=443

# API (white-label-stock-api). O servidor do web faz proxy de /api/** para cá.
# Local (Docker): a API publica a porta 8005 no host.
API_URL=http://host.docker.internal:8005

# SSR (Angular) — hosts aceitos no header Host (separados por vírgula).
# Em homolog/produção, inclua o domínio público (ex.: estoque.minhaempresa.com).
NG_ALLOWED_HOSTS=localhost,127.0.0.1
# Atrás do nginx (homolog/produção): x-forwarded-proto,x-forwarded-host,x-forwarded-for
NG_TRUST_PROXY_HEADERS=

# E2E (Playwright, roda no host) — banco da API, usado só para criar o usuário e2e e limpar
# os dados de teste (valores do .env da API: FORWARD_DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD).
E2E_DB_HOST=localhost
E2E_DB_PORT=5443
E2E_DB_DATABASE=white_label_stock
E2E_DB_USERNAME=postgres
E2E_DB_PASSWORD=postgres_password
