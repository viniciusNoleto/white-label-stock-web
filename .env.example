APP_ENV=local
APP_PORT=3005
# Homolog only — host port for HTTPS (nginx)
APP_SSL_PORT=443

POSTGRES_DB=white_label_inventory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5443

# Auto
POSTGRES_HOST=white-label-inventory-system-postgres

# SSR (Angular) — hosts aceitos no header Host (separados por vírgula).
# Em homolog/produção, inclua o domínio público (ex.: estoque.minhaempresa.com).
NG_ALLOWED_HOSTS=localhost,127.0.0.1
# Atrás do nginx (homolog/produção): x-forwarded-proto,x-forwarded-host,x-forwarded-for
NG_TRUST_PROXY_HEADERS=

# Cookies de sessão só por HTTPS em produção. Use false apenas para testar via HTTP.
COOKIE_SECURE=

# Seed — primeira conta de acesso (usada por `make db-seed`)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
