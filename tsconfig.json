        "./src/libs/ui/input-group/src/index.ts"
      ],
      "@spartan-ng/helm/card": [
        "./src/libs/ui/card/src/index.ts"
      ],
      "@spartan-ng/helm/alert-dialog": [
        "./src/libs/ui/alert-dialog/src/index.ts"
      ],
      "@spartan-ng/helm/switch": [
        "./src/libs/ui/switch/src/index.ts"
      ],
      "@spartan-ng/helm/skeleton": [
        "./src/libs/ui/skeleton/src/index.ts"
